---
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';

const audiences = [
  {
    who: 'Energy providers',
    what: 'Expected solar output of your own fleet for the next hours, updated every 10 minutes.',
  },
  {
    who: '15-minute market traders',
    what: 'Earlier, sharper view of market-wide solar infeed for intraday positions and imbalance risk.',
  },
  {
    who: 'Storage and flexible tariffs',
    what: 'Know when power will be cheap, and tell end users when to charge batteries, cars and heat pumps.',
  },
];

const costs = [
  {
    item: 'EUMETSAT data licence',
    href: 'https://user.eumetsat.int/resources/user-guides/data-registration-and-licensing',
    track: 'proposal-eumetsat-licence',
    amount: '8k EUR / year',
  },
  {
    item: 'GPU (one NVIDIA H200, running all year)',
    href: 'https://brev.nvidia.com/environment/new/public?gpu=H200',
    track: 'proposal-brev-gpu',
    amount: '6–7 USD / h ≈ 53–61k USD / year',
    per: 'per GPU · 2 members sequentially every 10 min',
    note: 'Conservative: solar only needs daylight runs, but a GPU is not reliably available on demand. Together we investigate the latency/price tradeoff, e.g. cheaper GPUs at slightly higher latency or daylight-only runs.',
  },
  {
    item: 'Storage (~16 GB / day, S3 standard)',
    amount: '< 1k USD',
    per: 'per member',
  },
  { item: 'My work', amount: 'on request' },
];

const steps = [
  { title: 'Discuss', text: 'A call with tech and business leads about the potential impact of low-latency high-resolution nowcasts.' },
  { title: 'Backtest', text: 'Measure the benefit on 17 days of existing demo data against your existing weather forecasts.' },
  { title: 'Run live for 2 weeks', text: 'Operational nowcasts on new satellite data, delivered to your systems.' },
  { title: 'Go to production', text: 'Hardened pipeline with monitoring, running in your cloud.' },
];
---

<Base
  head={{
    title: `Proposal: Solar Nowcasting | ${AppConfig.title}`,
    description: 'Proposal: AI solar nowcasting at 10-minute and 2 km resolution for energy providers, traders and storage operators.',
  }}
>
  <div class="mx-auto max-w-screen-md px-3 py-6">
    <p class="text-xs font-semibold uppercase tracking-wider text-cyan-400">Proposal</p>
    <h1 class="mt-2 text-3xl font-bold text-white">
      Solar nowcasting for energy markets
    </h1>
    <p class="mt-4 text-gray-300">
      AI nowcasts of solar output for the next hours, at 10-minute and 2 km
      resolution, built from EUMETSAT satellite data with NVIDIA Earth-2
      StormscopeEU. I set it up in your cloud. How much latency does your
      weather signal have?
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {audiences.map((a) => (
        <div class="rounded-lg border border-slate-700 bg-slate-800 p-4">
          <h2 class="text-sm font-semibold text-gray-100">{a.who}</h2>
          <p class="mt-1 text-sm text-gray-400">{a.what}</p>
        </div>
      ))}
    </div>

    <section class="mt-10">
      <!-- The dashboard lays out at a fixed 1920x1080; show only its map panel (x 24-1356, y 100-928). -->
      <div id="nowcast-crop" class="relative mt-4 overflow-hidden rounded-lg border border-slate-700" style="aspect-ratio: 1332 / 828;">
        <iframe
          src="https://nvidia-gtc-berlin-2026.earthmover.io/?variable=true_color"
          title="StormscopeEU live nowcast viewer"
          loading="lazy"
          width="1920"
          height="1080"
          class="absolute left-0 top-0 origin-top-left border-0"
          style="width: 1920px; height: 1080px; transform: scale(var(--s, 0.5)) translate(-24px, -100px);"
        ></iframe>
      </div>
      <script>
        const crop = document.getElementById('nowcast-crop');
        if (crop) {
          const fit = () => crop.style.setProperty('--s', String(crop.clientWidth / 1332));
          new ResizeObserver(fit).observe(crop);
          fit();
        }
        // GoatCounter events the click attributes cannot capture.
        const track = (path: string, title: string) => {
          const gc = (window as any).goatcounter;
          if (gc && gc.count) gc.count({ path, title, event: true });
        };
        // Clicking into the cross-origin map iframe moves focus out of this
        // window: count the first interaction with the live map.
        let mapUsed = false;
        addEventListener('blur', () => {
          if (!mapUsed && document.activeElement?.tagName === 'IFRAME') {
            mapUsed = true;
            track('proposal-map-interact', 'Proposal: Interacted with live map');
          }
        });
        // Count readers who scroll down to the "Let's talk" section.
        const end = document.getElementById('proposal-end');
        if (end) {
          const io = new IntersectionObserver((entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              track('proposal-read-to-end', 'Proposal: Scrolled to contact');
            }
          });
          io.observe(end);
        }
      </script>
      <p class="mt-1 text-xs text-gray-400">
        Live StormscopeEU nowcast over Europe.
        <a class="text-cyan-400 hover:text-cyan-300" href="https://nvidia-gtc-berlin-2026.earthmover.io/?variable=true_color" target="_blank" rel="noopener noreferrer" data-goatcounter-click="proposal-map-fullscreen" data-goatcounter-title="Proposal: Map full screen">Open full screen</a>
      </p>
      <p class="mt-3 text-sm text-gray-400">
        Background:
        <a class="text-cyan-400 hover:text-cyan-300" href="https://www.earthmover.io/blog/building-a-low-latency-earth-2-nowcasting-pipeline-with-earthmover" target="_blank" rel="noopener noreferrer" data-goatcounter-click="proposal-blog" data-goatcounter-title="Proposal: Blog post">Blog post</a>,
        <a class="text-cyan-400 hover:text-cyan-300" href="https://nvidia-gtc-berlin-2026.earthmover.io/" target="_blank" rel="noopener noreferrer" data-goatcounter-click="proposal-live-demo" data-goatcounter-title="Proposal: Live demo">Live Demo</a>,
        <a class="text-cyan-400 hover:text-cyan-300" href="https://app.earthmover.io/gtc-berlin/stormscope-eu_gtc_berlin_2026_EU_region" target="_blank" rel="noopener noreferrer" data-goatcounter-click="proposal-arraylake" data-goatcounter-title="Proposal: Arraylake repo">Arraylake repo</a>.
      </p>
    </section>

    <section id="costs" class="mt-10">
      <h2 class="text-xl font-semibold text-gray-100">Costs</h2>
      <div class="mt-3 overflow-x-auto rounded-lg border border-slate-700">
        <table class="w-full text-left text-sm">
          <tbody>
            {costs.map((c) => (
              <tr class="border-b border-slate-700 last:border-0">
                <td class="bg-slate-800 p-3 align-top text-gray-300">
                  {c.item}
                  {c.linkLabel && <span class="ml-1 text-xs text-gray-400">({c.linkLabel})</span>}
                  {c.note && <p class="mt-1 text-xs text-gray-400">{c.note}</p>}
                </td>
                <td class="whitespace-nowrap bg-slate-800 p-3 align-top font-medium text-gray-100">
                  {c.href ? (
                    <a class="text-cyan-400 hover:text-cyan-300" href={c.href} target="_blank" rel="noopener noreferrer" data-goatcounter-click={c.track} data-goatcounter-title={`Proposal: ${c.item}`}>{c.amount}</a>
                  ) : c.amount}
                  {c.per && <p class="text-xs font-normal text-gray-400">{c.per}</p>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-gray-100">Benefit</h2>
      <p class="mt-3 text-gray-300">
        The value depends on your portfolio and the decisions you make with it,
        so let's find it out together.
        Outputs for
        <a class="text-cyan-400 hover:text-cyan-300" href="https://app.earthmover.io/gtc-berlin/stormscope-eu_gtc_berlin_2026_EU_region" target="_blank" rel="noopener noreferrer" data-goatcounter-click="proposal-demo-data" data-goatcounter-title="Proposal: 17 demo days">17 demo days</a>
        are available.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-gray-100">Project milestones</h2>
      <ol class="mt-3 space-y-3">
        {steps.map((s, i) => (
          <li class="flex gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-cyan-500 text-sm font-semibold text-slate-900">{i + 1}</span>
            <div>
              <p class="font-medium text-gray-100">{s.title}</p>
              <p class="text-sm text-gray-400">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-10 rounded-lg border border-slate-700 bg-slate-800 p-4">
      <p class="text-gray-300">
        Suppose 10-minute, 2 km cloud cover were available as a data product.
        What value would it create for you? How to obtain:
      </p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-gray-300">
        <li>
          <strong class="text-gray-100">Build:</strong> an in-house capability,
          exclusive to you, set up together with me, see
          <a class="text-cyan-400 hover:text-cyan-300" href="#costs">costs</a>
        </li>
        <li>
          <strong class="text-gray-100">Buy:</strong> a data product, also sold
          to other paying customers. What would you be willing to pay?
        </li>
      </ul>
    </section>

    <section id="proposal-end" class="mx-auto mt-10 flex w-fit max-w-full flex-col items-center gap-2 rounded-xl bg-slate-800 px-8 py-6 text-center">
      <h2 class="text-2xl font-bold text-white">Let's talk</h2>
      <p class="text-gray-400">Share this internally and book a call with me.</p>
      <div class="mt-1 flex gap-4">
        <a
          href="https://www.linkedin.com/in/springaaron/"
          target="_blank"
          rel="noopener noreferrer"
          data-goatcounter-click="proposal-linkedin"
          data-goatcounter-title="Proposal: LinkedIn"
        >
          <img class="h-10 w-10 hover:translate-y-1" src="/assets/images/linkedin-icon.png" alt="LinkedIn" loading="lazy" />
        </a>
        <a
          href="mailto:draaronspring@proton.me?subject=Solar%20nowcasting%20proposal"
          aria-label="Email"
          data-goatcounter-click="proposal-email"
          data-goatcounter-title="Proposal: Email"
        >
          <svg class="h-10 w-10 stroke-cyan-500 hover:translate-y-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="M2 7l10 7 10-7" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</Base>
