---
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';

const audiences = [
  {
    who: 'Energy providers',
    what: 'Expected solar output of your own fleet for the next hours, updated every 10 minutes.',
  },
  {
    who: '15-minute market traders',
    what: 'Earlier, sharper view of market-wide solar infeed for intraday positions and imbalance risk.',
  },
  {
    who: 'Storage and flexible tariffs',
    what: 'Know when power will be cheap, and tell end users when to charge batteries, cars and heat pumps.',
  },
];

const costs = [
  {
    item: 'EUMETSAT data licence',
    href: 'https://user.eumetsat.int/resources/user-guides/data-registration-and-licensing',
    amount: '8k EUR / year',
  },
  {
    item: 'GPU (one NVIDIA B200, running all year)',
    href: 'https://brev.nvidia.com/environment/new/public?gpu=H200',
    linkLabel: 'B200 on NVIDIA Brev, Europe',
    amount: '6–7 USD / h ≈ 53–61k USD / year',
    note: 'Conservative: solar only needs daylight runs, but a GPU is not reliably available on demand. Together we investigate the latency/price tradeoff, e.g. cheaper GPUs or daylight-only runs at slightly higher latency.',
  },
  {
    item: 'Storage (~16 GB / day, S3 standard)',
    amount: '< 1k USD in year one',
  },
  { item: 'My work', amount: 'on request' },
];

const steps = [
  { title: 'Discuss', text: 'A call with tech and business leads about the potential impact of low-latency high-resolution nowcasts.' },
  { title: 'Test offline', text: 'Measure the benefit on 17 days of existing demo data against your existing weather forecasts.' },
  { title: 'Run live for 2 weeks', text: 'Operational nowcasts on new satellite data, delivered to your systems.' },
  { title: 'Go to production', text: 'Hardened pipeline with monitoring, running in your cloud.' },
];
---

<Base
  head={{
    title: `Proposal: Solar Nowcasting | ${AppConfig.title}`,
    description: 'Proposal: AI solar nowcasting at 10-minute and 2 km resolution for energy providers, traders and storage operators.',
  }}
>
  <div class="mx-auto max-w-screen-md px-3 py-6">
    <p class="text-xs font-semibold uppercase tracking-wider text-cyan-400">Proposal</p>
    <h1 class="mt-2 text-3xl font-bold text-white">
      Solar nowcasting <span class="bg-gradient-to-br from-sky-500 to-cyan-400 bg-clip-text text-transparent">for energy markets</span>
    </h1>
    <p class="mt-4 text-gray-300">
      AI nowcasts of solar output for the next hours, at 10-minute and 2 km
      resolution, built from EUMETSAT satellite data with NVIDIA Earth-2
      StormscopeEU. I set it up in your cloud.
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {audiences.map((a) => (
        <div class="rounded-lg border border-slate-700 bg-slate-800 p-4">
          <h2 class="text-sm font-semibold text-gray-100">{a.who}</h2>
          <p class="mt-1 text-sm text-gray-400">{a.what}</p>
        </div>
      ))}
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-gray-100">What's new</h2>
      <p class="mt-3 text-gray-300"><strong class="text-gray-100">10 minutes latency</strong> from satellite image to forecast, at <strong class="text-gray-100">10-minute and 2 km resolution</strong>, compared to numerical weather predictions lagged by 6 hours at 1-hour resolution.</p>
      <!-- The dashboard lays out at a fixed 1920x1080; show only its map panel (x 24-1356, y 100-928). -->
      <div id="nowcast-crop" class="relative mt-4 overflow-hidden rounded-lg border border-slate-700" style="aspect-ratio: 1332 / 828;">
        <iframe
          src="https://nvidia-gtc-berlin-2026.earthmover.io/?variable=true_color"
          title="StormscopeEU live nowcast viewer"
          loading="lazy"
          width="1920"
          height="1080"
          class="absolute left-0 top-0 origin-top-left border-0"
          style="width: 1920px; height: 1080px; transform: scale(var(--s, 0.5)) translate(-24px, -100px);"
        ></iframe>
      </div>
      <script>
        const crop = document.getElementById('nowcast-crop');
        if (crop) {
          const fit = () => crop.style.setProperty('--s', String(crop.clientWidth / 1332));
          new ResizeObserver(fit).observe(crop);
          fit();
        }
      </script>
      <p class="mt-1 text-xs text-gray-400">
        Live StormscopeEU nowcast over Europe.
        <a class="text-cyan-400 hover:text-cyan-300" href="https://nvidia-gtc-berlin-2026.earthmover.io/?variable=true_color" target="_blank" rel="noopener noreferrer">Open full screen</a>
      </p>
      <p class="mt-3 text-sm text-gray-400">
        Background:
        <a class="text-cyan-400 hover:text-cyan-300" href="https://www.earthmover.io/blog/building-a-low-latency-earth-2-nowcasting-pipeline-with-earthmover" target="_blank" rel="noopener noreferrer">Blog post</a>,
        <a class="text-cyan-400 hover:text-cyan-300" href="https://nvidia-gtc-berlin-2026.earthmover.io/" target="_blank" rel="noopener noreferrer">live demo</a>.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-gray-100">Costs</h2>
      <div class="mt-3 overflow-x-auto rounded-lg border border-slate-700">
        <table class="w-full text-left text-sm">
          <tbody>
            {costs.map((c) => (
              <tr class="border-b border-slate-700 last:border-0">
                <td class="bg-slate-800 p-3 align-top text-gray-300">
                  {c.href && !c.linkLabel ? (
                    <a class="text-cyan-400 hover:text-cyan-300" href={c.href} target="_blank" rel="noopener noreferrer">{c.item}</a>
                  ) : c.item}
                  {c.linkLabel && (
                    <a class="ml-1 text-xs text-cyan-400 hover:text-cyan-300" href={c.href} target="_blank" rel="noopener noreferrer">({c.linkLabel})</a>
                  )}
                  {c.note && <p class="mt-1 text-xs text-gray-400">{c.note}</p>}
                </td>
                <td class="whitespace-nowrap bg-slate-800 p-3 align-top font-medium text-gray-100">{c.amount}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-gray-100">Benefit</h2>
      <p class="mt-3 text-gray-300">
        The value depends on your portfolio and the decisions you make with it,
        so let's find it out together.
        Outputs for
        <a class="text-cyan-400 hover:text-cyan-300" href="https://app.earthmover.io/gtc-berlin/stormscope-eu_gtc_berlin_2026_EU_region" target="_blank" rel="noopener noreferrer">17 demo days</a>
        are available.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-gray-100">Next steps</h2>
      <ol class="mt-3 space-y-3">
        {steps.map((s, i) => (
          <li class="flex gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-cyan-500 text-sm font-semibold text-slate-900">{i + 1}</span>
            <div>
              <p class="font-medium text-gray-100">{s.title}</p>
              <p class="text-sm text-gray-400">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-10 rounded-lg border border-slate-700 bg-slate-800 p-4">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-cyan-400">A hypothetical</h2>
      <p class="mt-2 text-gray-300">
        If the setup costs are too high for you: what would you pay per month
        if I set up a company selling this nowcast data?
      </p>
    </section>

    <section class="mt-10 flex flex-col items-center gap-4 rounded-xl bg-slate-800 px-6 py-10 text-center">
      <h2 class="text-2xl font-bold text-white">Let's talk</h2>
      <p class="text-gray-400">Share this internally and book a call with me.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="mailto:draaronspring@proton.me?subject=Solar%20nowcasting%20proposal"
          data-goatcounter-click="proposal-email"
          data-goatcounter-title="Proposal: Email"
          class="rounded-lg bg-cyan-500 px-6 py-3 text-sm font-semibold text-slate-900 transition hover:bg-cyan-400"
        >draaronspring@proton.me</a>
        <a
          href="https://www.linkedin.com/in/springaaron/"
          target="_blank"
          rel="noopener noreferrer"
          data-goatcounter-click="proposal-linkedin"
          data-goatcounter-title="Proposal: LinkedIn"
          class="rounded-lg border border-cyan-500 px-6 py-3 text-sm font-semibold text-cyan-400 transition hover:bg-slate-700"
        >LinkedIn</a>
      </div>
    </section>
  </div>
</Base>
