---
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';

const workEntries = [
  {
    company: 'Freelance',
    dateStart: 'Jun 2026',
    dateEnd: 'Present',
    location: 'Remote',
    bullets: [
      'Architect and build low-latency pipelines bringing AI-based weather forecasts from satellite to users’ phones (90 s from GOES, 10 min from EUMETSAT) in collaboration with <a class="text-cyan-400 hover:text-cyan-300" href="https://www.earthmover.io/blog/building-a-low-latency-earth-2-nowcasting-pipeline-with-earthmover">NVIDIA</a> and <a class="text-cyan-400 hover:text-cyan-300" href="https://huggingface.co/blog/hugging-science/earthmover-hf">Hugging Face</a>',
      'Own the AWS pipeline of an analysis-ready, cloud-optimized, daily-updating dual-chunked ERA5 data cube (500TB + 20GB/day) for the Earthmover marketplace',
      'Run 2-day hands-on <a class="text-cyan-400 hover:text-cyan-300" href="/#ai-product-engineering-workshops">AI trainings</a> on working effectively with coding agents for <a class="text-cyan-400 hover:text-cyan-300" href="https://www.hackersandwizards.dev/trainings/agentic-engineering-for-developers/">Hackers &amp; Wizards</a>',
    ],
  },
  {
    company: 'New Work SE (XING)',
    role: 'Data Scientist — AI Engineer',
    dateStart: 'Mar 2025',
    dateEnd: 'Mar 2026',
    location: 'Hamburg',
    bullets: [
      'Developed end-to-end LLM-powered recruiting agent from concept to production with RAG retrieval, reranking, prompting, tracing and guardrails',
      'Reduced recruiter review load by narrowing 20M profiles to 200 prescreened, then 10 interested applicants per posting via personalized outreach',
    ],
  },
  {
    company: 'New Work SE (XING Marketing Solutions)',
    role: 'Data Scientist — Machine Learning Engineer',
    dateStart: 'Jan 2023',
    dateEnd: 'Feb 2025',
    location: 'Hamburg',
    bullets: [
      'Migrated ad CTR prediction from logistic regression to a deep neural network as calibrated recommender system, delivering 2% RPI uplift for a €14M business',
      'Feature engineering for personalization of CTR prediction and A/B testing',
      'Developed LLM-powered ad copy improvement reaching 10% adoption within three months and improving CTR by 15%',
    ],
  },
  {
    company: 'Max-Planck-Institut für Meteorologie',
    role: 'PostDoc',
    dateStart: 'May 2021',
    dateEnd: 'Jan 2023',
    location: 'Hamburg',
    bullets: [
      'Disentangled the COVID-19 response from variability in atmospheric CO₂',
    ],
  },
  {
    id: 'wmo',
    company: 'World Meteorological Organization',
    role: 'Data Engineer (part-time)',
    dateStart: 'Apr 2021',
    dateEnd: 'Feb 2022',
    location: 'Remote',
    bullets: [
      'Hosted the <a class="text-cyan-400 hover:text-cyan-300" href="https://s2s-ai-challenge.github.io/">S2S AI Challenge</a> improving subseasonal weather predictions with machine learning, with 50 participants',
      'Architected data pipeline on renkulab.io for 5TB+ of forecast data',
    ],
  },
  {
    company: 'Max-Planck-Institut für Meteorologie',
    role: 'PhD Candidate',
    dateStart: 'Mar 2018',
    dateEnd: 'Apr 2021',
    location: 'Hamburg',
    bullets: [
      'Orchestrated Earth-System-Model simulations and analyzed a 40TB+ data cube',
      'Co-created & maintained <a class="text-cyan-400 hover:text-cyan-300" href="https://github.com/pangeo-data/climpred">climpred</a>, open-source forecast-verification package',
      'Published three peer-reviewed first-author papers',
      'PhD thesis: <a class="text-cyan-400 hover:text-cyan-300" href="https://pure.mpg.de/rest/items/item_3289580/component/file_3325415/content">Internal Variability and Potential Predictability of the Global Carbon Cycle in a Perfect-Model Framework</a> (PDF)',
    ],
  },
];

const education = [
  { degree: 'Dr. rer. nat.', school: 'Max-Planck-Institut für Meteorologie, Hamburg', dates: 'Mar 2018 – Apr 2021', grade: '1.1' },
  { degree: 'MSc Physics', school: 'Ruprecht-Karls-Universität Heidelberg', dates: 'Sep 2014 – Aug 2017', grade: '1.3' },
  { degree: 'BSc Physics', school: 'Ruprecht-Karls-Universität Heidelberg', dates: 'Sep 2010 – Feb 2014', grade: '1.8' },
];

const skills = [
  { label: 'Languages', items: 'Python, SQL, Scala, Bash' },
  { label: 'GeoOps', items: 'xarray, dask, numpy, geopandas, icechunk, zarr, netCDF, GRIB, parquet, shapefiles' },
  { label: 'Data Science', items: 'pandas, TensorFlow, PyTorch, scikit-learn, MLflow, Metaflow, Snowflake, Spark, Airflow' },
  { label: 'DevOps', items: 'CI/CD, TDD, EDD, GitHub Actions, git, Docker, FastAPI, REST, AWS' },
  { label: 'LLMOps', items: 'LangChain, Qdrant, Langfuse, sentence-transformers, pydantic, skills/MCP, Claude' },
  { label: 'Spoken', items: 'German (native), English (C1), French (B1)' },
];
---

<Base head={{ title: `CV | ${AppConfig.title}`, description: 'CV of Aaron Spring.' }}>
  <div class="mx-auto max-w-screen-lg px-3 py-6">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">
        CV <span class="bg-gradient-to-br from-sky-500 to-cyan-400 bg-clip-text text-transparent">/ Work History</span>
      </h1>
    </div>
    <div class="flex flex-col gap-6">
      {workEntries.map((entry) => (
        <div id={entry.id} class="scroll-mt-20 rounded-lg border border-slate-700 bg-slate-800 p-6">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <div>
              <h2 class="text-lg font-semibold text-gray-100">{entry.company}</h2>
              {entry.role && <p class="text-sm italic text-cyan-400">{entry.role}</p>}
            </div>
            <p class="shrink-0 text-sm text-gray-400">
              {entry.dateStart} – {entry.dateEnd} · {entry.location}
            </p>
          </div>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-gray-300">
            {entry.bullets.map((b) => <li set:html={b}></li>)}
          </ul>
        </div>
      ))}
    </div>

    <h2 class="mb-4 mt-10 text-2xl font-bold text-white">Education</h2>
    <div class="flex flex-col gap-3 rounded-lg border border-slate-700 bg-slate-800 p-6">
      {education.map((e) => (
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <p class="text-gray-100">
            <span class="font-semibold">{e.degree}</span>
            <span class="text-gray-300">, {e.school}</span>
            <span class="text-sm text-gray-400"> (Grade {e.grade})</span>
          </p>
          <p class="shrink-0 text-sm text-gray-400">{e.dates}</p>
        </div>
      ))}
    </div>

    <h2 class="mb-4 mt-10 text-2xl font-bold text-white">Skills</h2>
    <dl class="grid grid-cols-1 gap-x-6 gap-y-2 rounded-lg border border-slate-700 bg-slate-800 p-6 text-sm sm:grid-cols-[9rem_1fr]">
      {skills.map((s) => (
        <Fragment>
          <dt class="font-semibold text-cyan-400">{s.label}</dt>
          <dd class="mb-2 text-gray-300 sm:mb-0">{s.items}</dd>
        </Fragment>
      ))}
    </dl>

    <div class="mt-10 flex justify-center">
      <a
        href="/cv_aaron_spring_2026.pdf"
        download
        data-goatcounter-click="cv-download-work"
        data-goatcounter-title="Download CV (work)"
        class="inline-flex items-center gap-2 rounded-lg bg-cyan-500 px-6 py-3 text-sm font-semibold text-slate-900 transition hover:bg-cyan-400"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download CV (PDF)
      </a>
    </div>
  </div>
</Base>
