---
import { Footer } from '@/partials/Footer';
import { Navbar } from '@/partials/Navbar';
import { AppConfig } from '@/utils/AppConfig';
import '@/styles/theme.css';

export interface Props {
  head: {
    title: string;
    description: string;
  };
}

const {
  head: { title, description },
} = Astro.props as Props;
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{title}</title>
    <meta name='description' content={description} />
    <meta name='author' content={AppConfig.author} />

    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <script is:inline>
      // Applied before first paint so the chosen theme never flashes.
      // An explicit choice from the toggle wins; otherwise follow the OS,
      // falling back to dark when it expresses no preference.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {
          /* storage unavailable: fall through to the OS preference */
        }
        var light = stored
          ? stored === 'light'
          : window.matchMedia('(prefers-color-scheme: light)').matches;
        if (light) {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
    <script is:inline>
      // Include the #anchor in the recorded path so in-page sections
      // (e.g. /#value, /#projects) show up as distinct pages in GoatCounter.
      window.goatcounter = {
        path: function (p) {
          // Click events (data-goatcounter-click) pass their own name rather
          // than a path, and the hashchange count below already carries the
          // hash: only a plain page path gets the #anchor appended.
          if (!p || p.charAt(0) !== '/' || p.indexOf('#') !== -1) return p;
          return p + location.hash;
        },
      };
      // Re-count whenever the hash changes (anchor navigation within a page).
      addEventListener('hashchange', function () {
        window.goatcounter.count({
          path: location.pathname + location.search + location.hash,
        });
      });
    </script>
    <script data-goatcounter="https://aaronspring.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class='bg-slate-900 text-gray-100'>
    <Navbar />

    <slot></slot>

    <Footer />

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var isLight = document.documentElement.classList.toggle('light');
        try {
          localStorage.setItem('theme', isLight ? 'light' : 'dark');
        } catch (e) {
          /* storage unavailable: the choice just won't persist */
        }
      });

      // Track the OS switching (e.g. macOS auto appearance at sunset) until
      // the visitor picks a theme themselves.
      window
        .matchMedia('(prefers-color-scheme: light)')
        .addEventListener('change', function (event) {
          try {
            if (localStorage.getItem('theme')) return;
          } catch (e) {
            /* storage unavailable: no stored choice to respect */
          }
          document.documentElement.classList.toggle('light', event.matches);
        });
    </script>
  </body>
</html>
