---
import { Footer } from '@/partials/Footer';
import { Navbar } from '@/partials/Navbar';
import { AppConfig } from '@/utils/AppConfig';
import '@/styles/theme.css';

export interface Props {
  head: {
    title: string;
    description: string;
  };
}

const {
  head: { title, description },
} = Astro.props as Props;
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{title}</title>
    <meta name='description' content={description} />
    <meta name='author' content={AppConfig.author} />

    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <script is:inline>
      // Applied before first paint so the chosen theme never flashes.
      // Dark is the default; only an explicit "light" choice is stored.
      (function () {
        try {
          if (localStorage.getItem('theme') === 'light') {
            document.documentElement.classList.add('light');
          }
        } catch (e) {
          /* storage unavailable: stay on the dark default */
        }
      })();
    </script>
    <script is:inline>
      // Include the #anchor in the recorded path so in-page sections
      // (e.g. /#value, /#projects) show up as distinct pages in GoatCounter.
      window.goatcounter = {
        path: function (p) {
          return p + location.hash;
        },
      };
      // Re-count whenever the hash changes (anchor navigation within a page).
      addEventListener('hashchange', function () {
        window.goatcounter.count({
          path: location.pathname + location.search + location.hash,
        });
      });
    </script>
    <script data-goatcounter="https://aaronspring.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class='bg-slate-900 text-gray-100'>
    <Navbar />

    <slot></slot>

    <Footer />

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var isLight = document.documentElement.classList.toggle('light');
        try {
          localStorage.setItem('theme', isLight ? 'light' : 'dark');
        } catch (e) {
          /* storage unavailable: the choice just won't persist */
        }
      });
    </script>
  </body>
</html>
