---
import { Footer } from '@/partials/Footer';
import { Navbar } from '@/partials/Navbar';
import { AppConfig } from '@/utils/AppConfig';
import '@/styles/theme.css';

export interface Props {
  head: {
    title: string;
    description: string;
  };
  hideNav?: boolean;
  /** Keep the page out of search results (e.g. Impressum, Datenschutz). */
  noindex?: boolean;
  /** Structured data for this page, emitted as JSON-LD. */
  jsonLd?: Record<string, unknown>;
  /** Social preview image, absolute or root-relative. */
  image?: string;
}

const {
  head: { title, description },
  hideNav = false,
  noindex = false,
  jsonLd,
  image = '/og-image.png',
} = Astro.props as Props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{title}</title>
    <meta name='description' content={description} />
    <meta name='author' content={AppConfig.author} />
    {noindex && <meta name='robots' content='noindex' />}
    <link rel='canonical' href={canonical} />

    <meta property='og:type' content='website' />
    <meta property='og:site_name' content={AppConfig.site_name} />
    <meta property='og:locale' content='en_US' />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:url' content={canonical} />
    <meta property='og:image' content={imageUrl} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content={`${AppConfig.author}: ${AppConfig.job_title}`} />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={imageUrl} />
    {jsonLd && (
      <script type='application/ld+json' set:html={JSON.stringify(jsonLd)} />
    )}

    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <script is:inline>
      // Applied before first paint so the chosen theme never flashes.
      // An explicit choice from the toggle wins; otherwise follow the OS,
      // falling back to dark when it expresses no preference.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {
          /* storage unavailable: fall through to the OS preference */
        }
        var light = stored
          ? stored === 'light'
          : window.matchMedia('(prefers-color-scheme: light)').matches;
        if (light) {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
    <script is:inline>
      // Include the #anchor in the recorded path so in-page sections
      // (e.g. /#value, /#projects) show up as distinct pages in GoatCounter.
      window.goatcounter = {
        path: function (p) {
          // Click events (data-goatcounter-click) pass their own name rather
          // than a path, and the hashchange count below already carries the
          // hash: only a plain page path gets the #anchor appended.
          if (!p || p.charAt(0) !== '/' || p.indexOf('#') !== -1) return p;
          return p + location.hash;
        },
      };
      // Re-count whenever the hash changes (anchor navigation within a page).
      addEventListener('hashchange', function () {
        window.goatcounter.count({
          path: location.pathname + location.search + location.hash,
        });
      });
    </script>
    <script data-goatcounter="https://aaronspring.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class='bg-slate-900 text-gray-100'>
    {!hideNav && <Navbar />}

    <slot></slot>

    <Footer />

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var isLight = document.documentElement.classList.toggle('light');
        try {
          localStorage.setItem('theme', isLight ? 'light' : 'dark');
        } catch (e) {
          /* storage unavailable: the choice just won't persist */
        }
      });

      // Track the OS switching (e.g. macOS auto appearance at sunset) until
      // the visitor picks a theme themselves.
      window
        .matchMedia('(prefers-color-scheme: light)')
        .addEventListener('change', function (event) {
          try {
            if (localStorage.getItem('theme')) return;
          } catch (e) {
            /* storage unavailable: no stored choice to respect */
          }
          document.documentElement.classList.toggle('light', event.matches);
        });
    </script>
  </body>
</html>
